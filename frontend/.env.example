# Copia este archivo como .env.local y llena los valores.
# Vite solo expone al navegador las variables que empiezan con VITE_
# (en Vercel usa exactamente estos mismos nombres).

# Supabase → Settings → API Keys / Data API
VITE_SUPABASE_URL=https://TU-PROJECT-ID.supabase.co
VITE_SUPABASE_KEY=TU_PUBLISHABLE_O_ANON_KEY

# URL de tu servicio en Render (sin / al final)
VITE_ML_API_URL=https://eduinsights-ml-api.onrender.com

VITE_APP_TITLE=EduInsights
